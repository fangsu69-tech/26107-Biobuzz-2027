    public void stopPollen() {
        setRPMPollen(););
        PollenMotor.setPower(0);
        velocityPID.reset(); // Clear integral sum when stopping
        TelemetryUtils.addData("targetRPMPollen", 0);
    }

    public void stopNectar() {
        setRPMNectar(0);
        NectarMotor.setPower(0);
        velocityPID.reset(); // Clear integral sum when stopping
        TelemetryUtils.addData("targetRPMNectar", 0);
    }

    // Helps to see how close you are to your target in Telemetry
    public double getCurrentRPMPollen() {
        return (PollenMotor.getVelocity() * 60.0) / TPerRot;
    }
    public double getCurrentRPMNectar() {
        return (NectorMotor.getVelocity() * 60.0) / TPerRot;
    }
}
package org.firstinspires.ftc.teamcode.subsystems;
import com.bylazar.configurables.annotations.Configurable;
import com.bylazar.configurables.annotations.Sorter;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import org.firstinspires.ftc.teamcode.utils.PIDController;
import org.firstinspires.ftc.teamcode.utils.TelemetryUtils;

@Configurable
public class TwoShooterSubsystem {
    //configure the 2 motors
    private DcMotorEx PollenMotor;
    private DcMotorEx NectorMotor;

    //PID for later
    private PIDController velocityPID;

    //constants, need adjustements

    private final double TPerRot = 28;
    private double TargetTPerSec = 0;
    private long StateTransitionTime = 0;
    private boolean LastReadyState = false;
    @Sorter(sort = 0) static double kP = 0.005, kI = 0.01, kD = 0.0002, kF = 0.0005;
    @Sorter(sort = 1) static double rpmToletance = 200;


    public void initialize(com.qualcomm.robotcore.hardware.HardwareMap hwMap) {
        PollenMotor = hwMap.get(DcMotorEx.class, "PollenMotor");
        NectarMotor = hwMap.get(DcMotorEx.class, "NectarMotor");

        PollenMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        PollenMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        PollenMotor.setDirection(DcMotorSimple.Direction.REVERSE);

        NectarMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        NectarMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        NectarMotor.setDirection(DcMotorSimple.Direction.REVERSE);

        velocityPID = new PIDController(kP, kI, kD);
        velocityPID.setOutputMax(1.0);
    }

    // desired RPM --> T/Sec

    public void setRPM(double rpm){
        this.TargetTPerSec = (rpm * TPerRot)/60;
        TelemetryUtils.addData("targetRPM", rpm)
    }

    public void runPollen() {//PID stuff for the pollen shooter
        double currentTPerSecPollen = PollenMotor.getVelocity(); // ticks per second

        double feedforward = targetTicksPerSec * kF;
        double pidCorrectionPollen = velocityPID.output(targetTicksPerSec, currentTPerSecPollen);

        double totalPowerPollen = feedforward + pidCorrectionPollen;

        PollenMotor.setPower(totalPowerPollen);
    }
//grammer is important, wouldve been bad if i realised that its nectar and not nector when i finish coding
    public void runNectar() {//PID stuff for the nectar shooter
        double currentTicksPerSecNectar = NectarMotor.getVelocity(); // ticks per second

        double feedforward = targetTicksPerSec * kF;
        double pidCorrectionNectar = velocityPID.output(targetTicksPerSec, currentTicksPerSecNectar);

        double totalPowerNectar = feedforward + pidCorrectionNectar;

        NectarMotor.setPower(totalPowerNectar);
    }


}